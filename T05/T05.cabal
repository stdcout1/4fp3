cabal-version:      3.4
name:               T05
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Reed Mullanix
maintainer:         reedmullanix@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common ghc-options
    ghc-options: -Wall -fdefer-typed-holes

library
    import: ghc-options
    exposed-modules:
    build-depends:
        base ^>=4.19.2.0,
        containers >= 0.8,
    hs-source-dirs: src
    default-language: Haskell2010

test-suite quickcheck
    import: ghc-options
    default-language: Haskell2010
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    build-depends:
        base ^>=4.19.2.0,
        tasty >= 1.5,
        tasty-hunit >= 0.10,
        tasty-quickcheck >= 0.11,
        QuickCheck >= 2.10,
