cabal-version:      3.0
name:               a3
version:            0.1.0.0
license:            NONE
build-type:         Simple

common ghc-options
    ghc-options: -Wall -fdefer-typed-holes

common extensions
    default-extensions:
        BangPatterns
        BlockArguments
        ImportQualifiedPost
        OverloadedStrings
        ScopedTypeVariables
        TypeApplications

library
    import: ghc-options, extensions
    build-depends:
        base ^>=4.19.2.0,
        containers >= 0.7,
    default-language: Haskell2010
    hs-source-dirs: src
    exposed-modules:
      A3.Kernel
      A3.Permutation
      A3.Pretty
      A3.Syntax.Core
      A3.Syntax.Context
      A3.Syntax.Substitution

test-suite solution-test
    import: ghc-options, extensions
    other-modules:
    build-depends:
        base ^>=4.19.2.0,
        containers >= 0.7,
        tasty >= 1.5,
        tasty-hunit >= 0.10,
        tasty-hedgehog >= 1.4,
        hedgehog >= 1.7,
        a3
    default-language: Haskell2010
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        Spec.Kernel
        Spec.Permutation
        Spec.Syntax.Core
        Spec.Syntax.Substitution
