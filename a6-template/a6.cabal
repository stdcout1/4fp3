cabal-version: 3.0
name:          a6
version:       0.1.0.0
description:   Please see the README on GitHub at <https://github.com/githubuser/a6#readme>
homepage:      https://github.com/githubuser/a6#readme
bug-reports:   https://github.com/githubuser/a6/issues
author:        Author name here
maintainer:    example@example.com
copyright:     2026 Author name here
license:       BSD-3-Clause
build-type:    Simple

source-repository head
  type: git
  location: https://github.com/githubuser/a6

common shared-properties
  default-language: Haskell2010
  build-depends:
      base >=4.7 && <5
    , containers
  default-extensions:
      BangPatterns
      BlockArguments
      DeriveFunctor
      ImportQualifiedPost
      OverloadedStrings
      ScopedTypeVariables
      TypeApplications
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wmissing-home-modules
      -Wpartial-fields
      -Wredundant-constraints
      -fdefer-typed-holes

library
  import: shared-properties
  exposed-modules:
      A6.CataAna
      A6.Fix
      A6.Para
      A6.Poly
      A6.RegExp
  hs-source-dirs: src

test-suite a6-test
  import: shared-properties
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      Spec.CataAna
      Spec.Para
      Spec.RegExp
  hs-source-dirs: test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      a6
    , hedgehog >=1.5
    , tasty >=1.5
    , tasty-hedgehog >=1.4
    , tasty-hunit >=0.10
    , vector >=0.12
